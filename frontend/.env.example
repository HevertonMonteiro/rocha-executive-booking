# =============================================================================
# Variaveis de ambiente. Copie para .env.local (desenvolvimento) e cadastre as
# mesmas chaves no painel da Netlify (Site settings > Environment variables)
# marcando os SEGREDOS como "Contains secret values".
# NUNCA versione arquivos .env com valores reais.
# =============================================================================

# --- Banco de dados (Supabase) ------------------------------------------------
# Producao: string de conexao do POOLER em modo transacao (porta 6543), usando o
# papel de aplicacao `app_server` (NAO o usuario `postgres`). Ver docs/DEPLOY.md.
#   postgresql://app_server.<ref-do-projeto>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Desenvolvimento: banco local em arquivo (PGlite), sem instalar nada.
DATABASE_URL=pglite:./.data/dev

# --- Site ---------------------------------------------------------------------
# URL publica com https:// em producao (usada na verificacao de origem do admin).
SITE_URL=http://localhost:3000
# Opcional: liga o sitemap/canonical a este dominio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seguranca (gere valores aleatorios: `openssl rand -base64 48`) -----------
JWT_SECRET=
# 32 bytes em base64 (`openssl rand -base64 32`): cifra o segredo do MFA no banco
APP_ENCRYPTION_KEY=
# Em production o MFA (TOTP) do admin e obrigatorio por padrao
ADMIN_REQUIRE_MFA=false
# O admin e desconectado apos 30 min SEM atividade (renovado a cada uso), com teto absoluto
SESSAO_INATIVIDADE_MINUTOS=30
SESSAO_MAXIMA_HORAS=8
# "local": o painel so responde no proprio computador (padrao em desenvolvimento);
# "qualquer": acessivel pelo dominio publico (padrao em production). Nao precisa definir.
ADMIN_ACESSO=
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MINUTOS=15

# --- Pagamentos (SumUp) -------------------------------------------------------
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_PAY_TO_EMAIL=

# --- Pagamento de TESTE (sem SumUp) -------------------------------------------
# So para desenvolvimento/demonstracao: mostra um painel "MODE TEST" no lugar do cartao.
# NUNCA funciona em production (o servidor se recusa a iniciar se estiver ligado).
PAGAMENTO_SIMULADO=false

# --- Imagens (Supabase Storage) ----------------------------------------------
# STORAGE_DRIVER=local grava em public/uploads (so desenvolvimento).
STORAGE_DRIVER=local
SUPABASE_URL=
# Chave de SERVICO: secreta, somente no servidor. Nunca use NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-media
UPLOAD_MAX_MB=5

# --- Regras de negocio --------------------------------------------------------
# Reserva nao paga deixa de segurar o veiculo depois deste prazo
HOLD_PENDENTE_MINUTOS=30
# Margem de seguranca depois da viagem antes de o veiculo assumir outra
MARGEM_RETORNO_MINUTOS=15
